+/**
+ * Free descriptor number in the netlink range of @tracee, or -1 (also when its open file limit
+ * is too low, or when PROOT_FULL_RECV keeps every recvmsg traced so nothing needs moving).
+ * Read from /proc/<pid>/fd; the range is far above what programs normally open.
+ * @tracee의 netlink 구간에서 빈 디스크립터 번호, 없으면 -1(열린 파일 한도가 너무 낮거나 PROOT_FULL_RECV로
+ * 모든 recvmsg를 추적해 옮길 필요가 없을 때도 -1). /proc/<pid>/fd에서 읽음. 이 구간은 프로그램이 보통
+ * 여는 번호보다 훨씬 위임
+ */
+static int free_netlink_fd(const Tracee *tracee)
+{
+	struct rlimit limit;
+	struct stat st;
+	char path[64];
+	int fd;
+
+	if (getenv("PROOT_FULL_RECV") != NULL)
+		return -1;
+	if (prlimit(tracee->pid, RLIMIT_NOFILE, NULL, &limit) == 0
+	    && limit.rlim_cur != RLIM_INFINITY
+	    && limit.rlim_cur < (rlim_t) (NETLINK_FD_BASE + NETLINK_FD_COUNT))
+		return -1;
+	for (fd = NETLINK_FD_BASE; fd < NETLINK_FD_BASE + NETLINK_FD_COUNT; fd++) {
+		snprintf(path, sizeof(path), "/proc/%d/fd/%d", tracee->pid, fd);
+		if (lstat(path, &st) < 0 && errno == ENOENT)
+			return fd;
+	}
+	return -1;
+}
+
+/**
+ * Move a just created netlink socket of @tracee to the netlink range: dup3 to the free number
+ * (keeping close-on-exec), close the old one, and report the new number as socket()'s result.
+ * Returns the descriptor to record (the old one when it could not be moved; then its
+ * recvmsg/recvfrom are no longer seen, which is reported on stderr).
+ * 방금 만든 @tracee의 netlink 소켓을 netlink 구간으로 옮김: 빈 번호로 dup3(close-on-exec 유지), 옛 번호를
+ * 닫고, 새 번호를 socket() 결과로 돌려줌. 기록할 디스크립터를 돌려줌(옮기지 못하면 옛 번호. 그때는 그
+ * 소켓의 recvmsg/recvfrom을 볼 수 없으므로 stderr에 알림)
+ */
+static int move_netlink_fd(Tracee *tracee, int fd)
+{
+	int new_fd;
+	int flags;
+
+	if (fd >= NETLINK_FD_BASE && fd < NETLINK_FD_BASE + NETLINK_FD_COUNT)
+		return fd;
+	if (getenv("PROOT_FULL_RECV") != NULL)
+		return fd;
+	new_fd = free_netlink_fd(tracee);
+	if (new_fd < 0) {
+		fprintf(stderr, "proot: netlink fd %d not moved (no free number in %d..%d); "
+			"set PROOT_FULL_RECV if network lookups fail\n",
+			fd, NETLINK_FD_BASE, NETLINK_FD_BASE + NETLINK_FD_COUNT - 1);
+		return fd;
+	}
+	flags = (peek_reg(tracee, ORIGINAL, SYSARG_2) & SOCK_CLOEXEC) != 0 ? O_CLOEXEC : 0;
+	if (register_chained_syscall(tracee, PR_dup3, fd, new_fd, flags, 0, 0, 0) < 0
+	    || register_chained_syscall(tracee, PR_close, fd, 0, 0, 0, 0, 0) < 0)
+		return fd;
+	force_chain_final_result(tracee, (word_t) new_fd);
+	return new_fd;
+}
