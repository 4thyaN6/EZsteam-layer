+/**
+ * recvmsg/recvfrom: PRoot only rewrites them on the netlink sockets it watches, which exit.c
+ * moves to NETLINK_FD_BASE..+NETLINK_FD_COUNT; on any other descriptor they run without a stop.
+ * Only when no extension needs their exit stage (flags 0). PROOT_FULL_RECV set: trace all.
+ * Why: idle Steam made about 1000 such calls a second on its own sockets (web helper, X
+ * server, client), all of them stopping PRoot for nothing (PROOT_STAT, 2026-10-19).
+ * recvmsg/recvfrom: PRoot는 자기가 지켜보는 netlink 소켓에서만 고쳐 씀. exit.c가 그 소켓을
+ * NETLINK_FD_BASE..+NETLINK_FD_COUNT로 옮김. 다른 디스크립터에서는 멈춤 없이 실행됨. 확장이 종료 단계를
+ * 필요로 하지 않을 때만(flags 0). PROOT_FULL_RECV가 있으면 전부 추적함.
+ * 이유: 대기 중 Steam이 자기 소켓(웹 도우미, X 서버, 클라이언트)에서 초당 약 1000번 이 호출을 했고
+ * 모두 쓸데없이 PRoot를 멈췄음(PROOT_STAT, 2026-10-19)
+ */
+static bool recv_by_fd(Sysnum sysnum, int flags)
+{
+	return (sysnum == PR_recvmsg || sysnum == PR_recvfrom) && flags == 0
+		&& getenv("PROOT_FULL_RECV") == NULL;
+}
+
+#define LENGTH_TRACE_RECV 6
+
+/* Trace only when the first argument (descriptor, low 32 bits) is in the netlink range
+ * 첫 인자(디스크립터, 하위 32비트)가 netlink 구간일 때만 추적함 */
+static int add_trace_recv(struct sock_fprog *program, word_t syscall, int flag)
+{
+	struct sock_filter statements[LENGTH_TRACE_RECV] = {
+		/* Not this syscall: skip the block / 이 호출이 아니면 덩어리를 건너뜀 */
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, syscall, 0, LENGTH_TRACE_RECV - 1),
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, args[0])),
+		/* fd < BASE: allow / fd < BASE면 허용 */
+		BPF_JUMP(BPF_JMP + BPF_JGE + BPF_K, NETLINK_FD_BASE, 0, 1),
+		/* fd >= BASE + COUNT: allow, else trace / fd >= BASE + COUNT면 허용, 아니면 추적 */
+		BPF_JUMP(BPF_JMP + BPF_JGE + BPF_K, NETLINK_FD_BASE + NETLINK_FD_COUNT, 0, 1),
+		BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW),
+		BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE + flag),
+	};
+
+	if (syscall > UINT32_MAX)
+		return -ERANGE;
+
+	return add_statements(program, LENGTH_TRACE_RECV, statements);
+}
+
+/**
+ * sendto: PRoot needs it on the netlink range (fake replies) and whenever a destination address
+ * is given (Unix socket path translation); a plain send on a connected socket (address NULL,
+ * descriptor outside the range) runs without a stop. Same conditions as recv_by_fd().
+ * sendto: PRoot는 netlink 구간(가짜 응답)과 목적지 주소가 있을 때(유닉스 소켓 경로 변환)만 필요함.
+ * 연결된 소켓에 그냥 보내는 것(주소 NULL, 구간 밖 디스크립터)은 멈춤 없이 실행됨. 조건은 recv_by_fd()와 같음
+ */
+static bool sendto_by_fd(Sysnum sysnum, int flags)
+{
+	return sysnum == PR_sendto && flags == 0 && getenv("PROOT_FULL_RECV") == NULL;
+}
+
+#define LENGTH_TRACE_SENDTO 10
+#if __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error "sendto filter assumes little-endian argument words"
+#endif
+
+static int add_trace_sendto(struct sock_fprog *program, word_t syscall, int flag)
+{
+	const size_t addr = offsetof(struct seccomp_data, args[4]);
+	struct sock_filter statements[LENGTH_TRACE_SENDTO] = {
+		/* 0: not sendto, skip / sendto가 아니면 건너뜀 */
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, syscall, 0, LENGTH_TRACE_SENDTO - 1),
+		/* 1-3: descriptor in the netlink range -> trace / 디스크립터가 netlink 구간이면 추적 */
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, args[0])),
+		BPF_JUMP(BPF_JMP + BPF_JGE + BPF_K, NETLINK_FD_BASE, 0, 1),
+		BPF_JUMP(BPF_JMP + BPF_JGE + BPF_K, NETLINK_FD_BASE + NETLINK_FD_COUNT, 0, 5),
+		/* 4-7: destination address not NULL (both words) -> trace / 목적지 주소가 NULL이 아니면(두 워드) 추적 */
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, addr),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, 0, 0, 3),
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, addr + 4),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, 0, 0, 1),
+		/* 8: allow, 9: trace / 8: 허용, 9: 추적 */
+		BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW),
+		BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE + flag),
+	};
+
+	if (syscall > UINT32_MAX)
+		return -ERANGE;
+
+	return add_statements(program, LENGTH_TRACE_SENDTO, statements);
+}
+
