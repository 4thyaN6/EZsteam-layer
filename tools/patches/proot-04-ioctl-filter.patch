+	const size_t section_length = LENGTH_END_SECTION + nb_traced_syscalls;
 	int status;
 
 	/* Sanity checks.  */
@@ -275,7 +348,7 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 			for (k = 0; sysnums[k].value != PR_void; k++) {
 				syscall = detranslate_sysnum(seccomp_archs[i].abis[j], sysnums[k].value);
 				if (syscall != SYSCALL_AVOIDER)
-					nb_traced_syscalls++;
+					nb_traced_syscalls += trace_length(sysnums[k].value);
 			}
 		}
 
@@ -291,8 +364,11 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 				if (syscall == SYSCALL_AVOIDER)
 					continue;
 
-				/* Filter: trace if handled syscall */
-				status = add_trace_syscall(&program, syscall, sysnums[k].flags);
+				/* Filter: trace if handled syscall (ioctl: only some requests) */
+				if (ioctl_by_request(sysnums[k].value))
+					status = add_trace_ioctl(&program, syscall, sysnums[k].flags);
+				else
+					status = add_trace_syscall(&program, syscall, sysnums[k].flags);
 				if (status < 0)
 					goto end;
 			}
