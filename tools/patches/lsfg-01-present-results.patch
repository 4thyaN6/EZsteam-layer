diff --git a/src/hooks.cpp b/src/hooks.cpp
index 681f8e4..7c1db45 100644
--- a/src/hooks.cpp
+++ b/src/hooks.cpp
@@ -437,6 +437,17 @@ namespace {
             res = swapchain.present(deviceInfo, pPresentInfo->pNext,
                 queue, semaphores, *pPresentInfo->pImageIndices);
 
+            // EZsteam patch: frame generation presents with its own VkPresentInfoKHR, so the
+            // caller's per-swapchain results were never written. vkd3d-proton passes an
+            // uninitialised VkResult there and recreates its swapchain when it reads a failure,
+            // which made the game recreate its swapchain every few frames (flicker).
+            // EZsteam 패치: 프레임 생성은 자체 VkPresentInfoKHR로 present해서 호출한 쪽의 swapchain별 결과가
+            // 쓰이지 않았음. vkd3d-proton은 초기화하지 않은 VkResult를 넘기고 실패를 읽으면 swapchain을 다시 만들어
+            // 게임이 몇 프레임마다 swapchain을 다시 만들었음(깜빡임)
+            if (pPresentInfo->pResults)
+                for (uint32_t i = 0; i < pPresentInfo->swapchainCount; i++)
+                    pPresentInfo->pResults[i] = res;
+
             Utils::resetLimitN("swapPresent");
             Utils::resetLimitN("swapReconf");
             Utils::resetLimitN("swapStale");
@@ -444,6 +455,11 @@ namespace {
             Utils::logLimitN("swapPresent", 5,
                 "An error occurred while presenting the swapchain:\n"
                 "- " + std::string(e.what()));
+            // EZsteam patch: the caller's per-swapchain results match the returned error
+            // EZsteam 패치: 호출한 쪽의 swapchain별 결과를 돌려주는 오류와 맞춤
+            if (pPresentInfo->pResults)
+                for (uint32_t i = 0; i < pPresentInfo->swapchainCount; i++)
+                    pPresentInfo->pResults[i] = VK_ERROR_INITIALIZATION_FAILED;
             return VK_ERROR_INITIALIZATION_FAILED;
         }
         return res;
