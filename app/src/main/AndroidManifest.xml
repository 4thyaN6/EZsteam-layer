<?xml version="1.0" encoding="utf-8"?>
<!-- Test launcher app manifest. Network is used only when the user presses [rootfs 설치]
     (download from GitHub Release) and later by Steam itself; the app sends nothing on its own. -->
<!-- 시험용 실행기 매니페스트. 네트워크는 사용자가 [rootfs 설치]를 누를 때(GitHub Release 받기)와
     이후 Steam 자체만 씀. 앱이 스스로 보내는 것은 없음 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET comes from the :runtime module manifest / INTERNET은 :runtime 모듈에서 합쳐짐 -->

    <!-- Shared storage with EZlator (test builds): reports in Download/.EZlator/Reports and EZlator's
         Steam library (/storage/emulated/0/EZlator/SteamLibrary). Legacy model with targetSdk 28,
         the same permissions EZlator asks for; asked on start, the app works without them -->
    <!-- EZlator와 공용 저장소(시험 빌드): Download/.EZlator/Reports 제보와 EZlator Steam 라이브러리
         (/storage/emulated/0/EZlator/SteamLibrary). targetSdk 28의 기존 방식, EZlator가 요청하는 것과
         같은 권한. 시작할 때 물어보며 없어도 앱은 동작함 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Steam session kept at foreground priority while the user is in another app or the screen
         is off (SessionService): normal permissions, granted at install -->
    <!-- 사용자가 다른 앱에 있거나 화면이 꺼져도 Steam 세션을 포그라운드 우선순위로 유지(SessionService):
         일반 권한이며 설치 시 허용됨 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- extractNativeLibs is irrelevant (no JNI libs); glibc files live in the rootfs -->
    <!-- JNI 라이브러리가 없어 해당 없음. glibc 파일은 rootfs 안에 있음 -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Live display test (Xvfb screen + XTEST input), landscape full screen -->
        <!-- 실시간 화면 시험(Xvfb 화면 + XTEST 입력), 가로 전체 화면 -->
        <activity
            android:name=".DisplayActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:windowSoftInputMode="adjustNothing|stateHidden" />

        <!-- Foreground service of a running session / 실행 중인 세션의 포그라운드 서비스 -->
        <service
            android:name=".SessionService"
            android:exported="false" />
    </application>
</manifest>
