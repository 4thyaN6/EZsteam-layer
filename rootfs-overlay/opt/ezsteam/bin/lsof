#!/bin/sh
# lsof wrapper for the Steam client, installed in place of /usr/bin/lsof (dpkg-divert, see
# steam-install.sh) because the client runs /usr/bin/lsof and /bin/lsof by absolute path.
# The client asks "lsof -i TCP@127.0.0.1:<port>" to check that the peer of its local WebSocket is
# its own steamwebhelper. Android hides the owner of TCP sockets (/proc/net) from apps, so that one
# query is answered with the steamwebhelper network process in the field format the client
# accepts (same contract as steamclienttermux's shim). Every other call goes to the real lsof.
# Calls and answers are recorded in /tmp/ezs-lsof.log for diagnosis.
# Steam 클라이언트용 lsof 감쌈. 클라이언트가 /usr/bin/lsof, /bin/lsof를 절대 경로로 실행하므로
# /usr/bin/lsof 자리에 설치함(dpkg-divert, steam-install.sh 참고).
# 클라이언트는 "lsof -i TCP@127.0.0.1:<포트>"로 로컬 WebSocket 상대가 자기 steamwebhelper인지
# 확인함. 안드로이드는 앱에게 TCP 소켓 주인(/proc/net)을 숨기므로, 이 질의 하나만
# steamwebhelper 네트워크 프로세스로, 클라이언트가 받아들이는 필드 형식으로 답함
# (steamclienttermux 심과 같은 형식). 나머지 호출은 실제 lsof로 넘김.
# 호출과 답은 진단용으로 /tmp/ezs-lsof.log에 남김
LOG=/tmp/ezs-lsof.log

# Real lsof: the diverted original, else /usr/bin/lsof when this wrapper is not installed there
# 실제 lsof: 옮겨 둔 원본, 이 감쌈이 그 자리에 없으면 /usr/bin/lsof
REAL=/usr/bin/lsof.distrib
if [ ! -x "$REAL" ]; then
    REAL=/usr/bin/lsof
    [ "$(readlink -f "$REAL")" = "$(readlink -f "$0")" ] && REAL=""
fi

case " $* " in
    *" -i TCP@127.0.0.1:"*) ;;
    *)
        echo "$(date +%T) real: $*" >> "$LOG" 2>/dev/null
        [ -n "$REAL" ] && exec "$REAL" "$@"
        exit 1
        ;;
esac

port=0
for a do
    case "$a" in TCP@127.0.0.1:*) port=${a##*:} ;; esac
done
# Field output (-F style): p=pid, R=parent pid, u=uid, n=connection. Only the network service
# process itself matches (its --utility-sub-type), not a process that merely names the feature
# 필드 출력(-F 형식): p=pid, R=부모 pid, u=uid, n=연결. 네트워크 서비스 프로세스 자신(--utility-sub-type)만
# 맞춤(기능 이름만 인자로 가진 프로세스는 제외)
out=$(ps -eo pid=,ppid=,args= | awk -v uid="$(id -u)" -v port="$port" '
    /steamwebhelper/ && /network\.mojom\.NetworkService/ && !found {
        print "p" $1; print "R" $2; print "u" uid
        print "n127.0.0.1:" port "->127.0.0.1:27060"
        found = 1
    }')
echo "$(date +%T) shim: $* -> $(echo "$out" | tr '\n' ' ')" >> "$LOG" 2>/dev/null
[ -n "$out" ] || exit 1
printf '%s\n' "$out"
