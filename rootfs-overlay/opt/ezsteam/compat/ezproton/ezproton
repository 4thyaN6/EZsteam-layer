#!/bin/sh
# EZ Proton: hands Steam's compat call straight to Valve's own ARM64 Proton (downloaded by Steam).
# EZ Proton: Steam의 호환 도구 호출을 Steam이 받은 Valve ARM64 Proton에 그대로 넘김
#
# Steam runs:  <this dir>/ezproton <verb> <game command...>
# Steam 호출 형태:  <이 폴더>/ezproton <동작> <게임 명령...>
#
# Proton location, first match wins / Proton 위치, 앞에서부터 찾음:
#   1. EZ_PROTON_DIR environment variable / 환경변수
#   2. "proton-dir" file next to this script (one line) / 이 스크립트 옆 "proton-dir" 파일(한 줄)
#   3. <Steam>/steamapps/common/*/ whose toolmanifest.vdf requires appid 4185400 (Valve ARM64 build)
#      toolmanifest.vdf가 4185400을 요구하는 폴더(Valve ARM64 빌드)
set -u

SELF_DIR=$(cd "$(dirname "$0")" && pwd)
STEAM_DIR=${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$HOME/.local/share/Steam}
PROTON_DIR=${EZ_PROTON_DIR:-}

# Pinned path written by the launcher or the user
# 실행기나 사용자가 고정해 둔 경로
if [ -z "$PROTON_DIR" ] && [ -f "$SELF_DIR/proton-dir" ]; then
    PROTON_DIR=$(head -n 1 "$SELF_DIR/proton-dir")
fi

# Search the main library; glob order is alphabetical, so the last match wins
# (e.g. "Proton - Experimental" < "Proton 11.0 (Beta)")
# 기본 라이브러리에서 찾음. glob은 알파벳순이라 마지막으로 맞은 것이 선택됨
if [ -z "$PROTON_DIR" ]; then
    for m in "$STEAM_DIR"/steamapps/common/*/toolmanifest.vdf; do
        [ -f "$m" ] || continue
        if grep -q '4185400' "$m" 2>/dev/null && [ -f "$(dirname "$m")/proton" ]; then
            PROTON_DIR=$(dirname "$m")
        fi
    done
fi

if [ -z "$PROTON_DIR" ] || [ ! -f "$PROTON_DIR/proton" ]; then
    echo "ezproton: Valve ARM64 Proton not found (install Proton from the Steam library tools)" >&2
    exit 1
fi

# Proton log for the app's log view: ~/ezs-logs/steam-<appid>.log (Proton's PROTON_LOG/PROTON_LOG_DIR),
# unless the user set them already
# 앱 로그 화면용 Proton 로그: ~/ezs-logs/steam-<appid>.log(Proton의 PROTON_LOG/PROTON_LOG_DIR).
# 사용자가 이미 정했으면 그대로 둠
export PROTON_LOG="${PROTON_LOG:-1}"
# Wine debug channels for that log: errors and loaded DLLs only (Proton's default adds +seh, which
# writes every exception; FEX raises many misalignment exceptions, so that log slows the game)
# 그 로그의 Wine 디버그 채널: 오류와 불러온 DLL만(Proton 기본값은 +seh로 모든 예외를 기록하는데,
# FEX는 정렬 예외를 많이 내므로 그 기록이 게임을 느리게 함)
# +key (input diagnosis): Wine's X11 driver logs each key event it receives (X window, keycode,
# target hwnd; winex11 keyboard.c TRACE_(key)). "+keyboard" was tried first: it logs keymap setup
# only (about 25,000 lines, no key events)
# +key(입력 진단): Wine X11 드라이버가 받은 키 이벤트를 남김(X 창, 키코드, 보낼 hwnd, winex11
# keyboard.c TRACE_(key)). 먼저 써 본 "+keyboard"는 키 배치 준비만 남김(약 25,000줄, 키 이벤트 없음)
export WINEDEBUG="${WINEDEBUG:-+timestamp,+pid,+loaddll,+key,err+all,fixme-all}"
# Fewer resident Wine processes (Android allows 32 extra processes for all apps together):
# tabtip.exe (touch keyboard helper) is not needed; Proton appends this to its own overrides
# 상주 Wine 프로세스 줄이기(안드로이드는 모든 앱 합계 추가 프로세스 32개까지 허용):
# tabtip.exe(터치 키보드 보조)는 필요 없음. Proton이 자기 설정 뒤에 이 값을 덧붙임
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}tabtip.exe=d"
# Sound through ALSA (the app's plugin, see steam-run.sh): the PulseAudio driver is turned off so
# Wine does not try a PulseAudio server that does not exist here first
# 소리는 ALSA로 냄(앱 플러그인, steam-run.sh 참고): 여기에는 없는 PulseAudio 서버를 Wine이 먼저
# 찾지 않도록 PulseAudio 드라이버를 끔
export WINEDLLOVERRIDES="$WINEDLLOVERRIDES;winepulse.drv=d"
# Game controller: preload library that attaches a virtual Xbox 360 pad fed by the app (only acts
# in winedevice.exe, the process running Wine's winebus; see native/ezspad/ezs_pad.c). Wine passes
# LD_PRELOAD on to the processes it starts. Skipped when the file is missing
# 게임 컨트롤러: 앱이 상태를 넣는 가상 Xbox 360 패드를 붙이는 preload 라이브러리(Wine winebus가 도는
# winedevice.exe에서만 동작, native/ezspad/ezs_pad.c 참고). Wine이 자기가 띄우는 프로세스에
# LD_PRELOAD를 넘김. 파일이 없으면 건너뜀
EZS_PAD_LIB=/opt/ezsteam/lib/libezs_pad.so
if [ -f "$EZS_PAD_LIB" ]; then
    export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$EZS_PAD_LIB"
fi
export PROTON_LOG_DIR="${PROTON_LOG_DIR:-$HOME/ezs-logs}"
mkdir -p "$PROTON_LOG_DIR"

# Valve's script is "#!/usr/bin/env python3"; under PRoot it resolves to the rootfs python3
# Valve 스크립트는 "#!/usr/bin/env python3"이며 PRoot 안에서는 rootfs의 python3로 실행됨
echo "ezproton: $PROTON_DIR $*" >&2
# Frame hand-over settings that reached the game (set by the app, see steam-run.sh)
# 게임까지 전달된 화면 전달 설정(앱이 정함, steam-run.sh 참고)
echo "ezproton: MESA_VK_WSI_DEBUG=${MESA_VK_WSI_DEBUG:-} MESA_VK_WSI_PRESENT_MODE=${MESA_VK_WSI_PRESENT_MODE:-} DXVK_CONFIG=${DXVK_CONFIG:-} DXVK_HUD=${DXVK_HUD:-}" >&2
echo "ezproton: LD_PRELOAD=${LD_PRELOAD:-}" >&2
exec "$PROTON_DIR/proton" "$@"
